<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.monet</groupId>
    <artifactId>modeleditor</artifactId>
    <version>3.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>org.monet.editor</artifactId>
  <packaging>jar</packaging>
  <name>Monet Editor</name>
  <dependencies>
    <dependency><groupId>org.monet</groupId><artifactId>org.monet.editor.dsl.ui</artifactId><version>3.0.0</version></dependency>
    <dependency><groupId>org.monet</groupId><artifactId>org.monet.metamodel</artifactId><version>3.0.0</version></dependency>
    <dependency><groupId>org.monet</groupId><artifactId>org.monet.editor.base</artifactId><version>3.0.0</version></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>bcmail-jdk15-145.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/bcmail-jdk15-145.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>bcprov-jdk15-145.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/bcprov-jdk15-145.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>commons-logging-1.1.1.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/commons-logging-1.1.1.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>diff.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/diff.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>httpclient-4.1.1.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/httpclient-4.1.1.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>httpclient-cache-4.1.1.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/httpclient-cache-4.1.1.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>httpcore-4.1.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/httpcore-4.1.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>httpmime-4.1.1.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/httpmime-4.1.1.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>json-lib-2.4-jdk15.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/json-lib-2.4-jdk15.jar</systemPath></dependency>
    <dependency><groupId>thirdparty</groupId><artifactId>templation.jar</artifactId><version>1.0</version><scope>system</scope><systemPath>${basedir}/lib/templation.jar</systemPath></dependency>
  </dependencies>
  <build>
    <sourceDirectory>src</sourceDirectory>
    <resources>
      <resource>
        <directory>${basedir}</directory>
        <filtering>true</filtering>
        <includes><include>META-INF/MANIFEST.MF</include></includes>
      </resource>
      <resource>
        <directory>${basedir}</directory>
        <filtering>false</filtering>
        <includes>
          <include>plugin.xml</include>
          <include>icons/**</include>
          <include>resources/**</include>
        </includes>
      </resource>
      <resource>
        <directory>${basedir}/lib</directory>
        <filtering>false</filtering>
        <targetPath>lib</targetPath>
        <includes>
          <include>bcmail-jdk15-145.jar</include>
          <include>bcprov-jdk15-145.jar</include>
          <include>commons-logging-1.1.1.jar</include>
          <include>diff.jar</include>
          <include>httpclient-4.1.1.jar</include>
          <include>httpclient-cache-4.1.1.jar</include>
          <include>httpcore-4.1.jar</include>
          <include>httpmime-4.1.1.jar</include>
          <include>json-lib-2.4-jdk15.jar</include>
          <include>templation.jar</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-to-site</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <tasks>
                <mkdir dir="${basedir}/../target/site/${site.subdir}"/>
                <copy file="${project.build.directory}/${artifactId}_${bundle.version}.jar" tofile="${basedir}/../target/site/${site.subdir}/${artifactId}_${bundle.version}.jar"/>
              </tasks>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
